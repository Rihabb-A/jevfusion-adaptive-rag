# Copy this file to .env and fill in your own values. Never commit the
# real .env file.

# --- Baseline (DAT reproduction) -------------------------------------------
# All baseline API calls go through OpenRouter, which exposes an
# OpenAI-compatible API (use the `openai` SDK with OPENROUTER_BASE_URL).
# Get a key at https://openrouter.ai/keys and set a credit limit on it.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# DAT's own settings (paper §5.1). Change only with a documented reason in
# baseline/README.md, since any change makes the run "DAT-style".
DAT_JUDGE_MODEL=openai/gpt-4o-mini
DAT_EMBED_MODEL=openai/text-embedding-3-large

# --- Extension (JevFusion) -------------------------------------------------
# Fill in from your Jev account's own documentation, verified with a smoke
# test before writing the adapter.
JEV_API_KEY=
# Pinned version, not the jev-latest alias: aliases move to new releases
# without notice, which would change results between tune and test runs.
JEV_MODEL=jev-1.13.0
JEV_API_BASE=https://api.typesafe.ai/v1

# --- Budget ----------------------------------------------------------------
# Course cap is USD 20 total for the whole team project. Our scripts refuse
# to start a run whose estimated cost would push the ledger past this.
BUDGET_CAP_USD=20

# --- Optional --------------------------------------------------------------
# Course lecture default (Gemini free tier), not used by this project's
# baseline: https://aistudio.google.com/apikey
# GOOGLE_API_KEY=
